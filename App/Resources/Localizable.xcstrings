{
  "sourceLanguage": "en",
  "strings": {
    "%@ is ready": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hazır"
          }
        }
      }
    },
    "%lld programs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld program"
          }
        }
      }
    },
    "A bottle is a self-contained Windows environment. Create one, then install or drop in any Windows program.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişe, kendi içinde bağımsız bir Windows ortamıdır. Bir tane oluşturun, ardından herhangi bir Windows programını kurun ya da sürükleyip bırakın."
          }
        }
      }
    },
    "A fresh Windows environment with its own C: drive and settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi C: sürücüsü ve ayarları olan yepyeni bir Windows ortamı."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Add Variable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişken Ekle"
          }
        }
      }
    },
    "Advertise AVX to Rosetta": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta'ya AVX desteği bildir"
          }
        }
      }
    },
