      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişe"
          }
        }
      }
    },
    "Bottle names can be up to %lld characters.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişe adları en fazla %lld karakter olabilir."
          }
        }
      }
    },
    "Bottle names can't contain “/” or “:”.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişe adları “/” veya “:” içeremez."
          }
        }
      }
    },
    "Bottles": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişeler"
          }
        }
      }
    },
    "Bottles folder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişeler klasörü"
          }
        }
      }
    },
    "Bourbon is free software under the GNU GPL v3. It is inspired by Whisky by Isaac Marovitz and contributors, and builds on Wine, DXVK, MoltenVK and winetricks.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bourbon, GNU GPL v3 lisanslı özgür bir yazılımdır. Isaac Marovitz ve katkıcılarının geliştirdiği Whisky'den ilham alır; Wine, DXVK, MoltenVK ve winetricks üzerine kuruludur."
          }
        }
      }
    },
    "Bourbon uses Wine to translate Windows calls into macOS ones. Use one you already have, or download a fresh build.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bourbon, Windows çağrılarını macOS çağrılarına çevirmek için Wine kullanır. Elinizdekini kullanın ya da yeni bir sürüm indirin."
          }
        }
      }
    },
