      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehribar"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm"
          }
        }
      }
    },
    "Applying settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar uygulanıyor"
          }
        }
      }
